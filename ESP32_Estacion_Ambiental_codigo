// ======================================================
// VALIDAR NÚMERO RECIBIDO
// ======================================================

bool numero(const char *s, float &v) {

  if (
    !s[0] ||
    s[0] == ' ' ||
    s[0] == '\t'
  ) {
    return false;
  }


  char *fin;


  v = strtof(
    s,
    &fin
  );


  return
    fin != s &&
    *fin == '\0' &&
    isfinite(v);
}


// ======================================================
// VALIDAR TRAMA CSV DEL ARDUINO
// ======================================================

bool aceptar(char *linea) {

  char *campos[5];

  campos[0] = linea;

  int n = 1;


  // Separar campos por comas

  for (
    char *p = linea;
    *p;
    ++p
  ) {

    if (*p == ',') {

      if (n == 5) {
        return false;
      }

      *p = '\0';

      campos[n++] = p + 1;
    }
  }


  if (n != 5) {
    return false;
  }


  // ------------------------------
  // Estado DHT
  // ------------------------------

  bool ok;


  if (!strcmp(campos[4], "1")) {

    ok = true;

  }

  else if (!strcmp(campos[4], "0")) {

    ok = false;

  }

  else {

    return false;
  }


  float t = 0;
  float h = 0;
  float m;
  float o;


  // ------------------------------
  // Validar DHT11
  // ------------------------------

  if (ok) {

    if (
      !numero(campos[0], t) ||
      !numero(campos[1], h) ||
      t < -40 ||
      t > 80 ||
      h < 0 ||
      h > 100
    ) {

      return false;
    }
  }

  else if (
    strcmp(campos[0], "nan") ||
    strcmp(campos[1], "nan")
  ) {

    return false;
  }


  // ------------------------------
  // Validar MQ-9
  // ------------------------------

  if (
    !numero(campos[2], m) ||
    m < 0 ||
    m > 1023 ||
    floorf(m) != m
  ) {

    return false;
  }


  // ------------------------------
  // Validar DSM501A
  // ------------------------------

  if (
    !numero(campos[3], o) ||
    (
      o != -1 &&
      (
        o < 0 ||
        o > 100
      )
    )
  ) {

    return false;
  }


  // ==================================================
  // ACTUALIZAR DATOS
  // ==================================================

  // Solo se actualizan después de validar
  // correctamente los cinco campos.

  temperatura = t;

  humedad = h;

  mq = (int)m;

  dsm = o;

  dhtOk = ok;

  recibido = true;

  ultimaTrama = millis();


  Serial.printf(
    "RX valida: MQ=%d DSM=%.3f DHT=%s\n",
    mq,
    dsm,
    ok ? "OK" : "ERROR"
  );


  return true;
}


// ======================================================
// LEER COMUNICACIÓN UART DESDE ARDUINO
// ======================================================

void leerUART() {

  // Si una trama queda incompleta demasiado tiempo,
  // se descarta para resincronizar.

  if (
    usados &&
    (uint32_t)(millis() - ultimoByte) > 500
  ) {

    usados = 0;

    descartar = true;
  }


  // Máximo 128 bytes por vuelta.
  //
  // Así el ESP32 puede seguir atendiendo
  // simultáneamente el servidor HTTP.

  for (
    int i = 0;
    i < 128 && Serial1.available();
    ++i
  ) {

    char c = (char)Serial1.read();

    ultimoByte = millis();


    if (c == '\n') {

      if (!descartar) {

        if (
          usados &&
          bufferRx[usados - 1] == '\r'
        ) {

          --usados;
        }


        bufferRx[usados] = '\0';


        if (!aceptar(bufferRx)) {

          ++rechazadas;

          Serial.println(
            "CSV rechazado"
          );
        }

      }

      else {

        ++rechazadas;

        Serial.println(
          "Trama descartada: longitud, ruido o timeout"
        );
      }


      usados = 0;

      descartar = false;
    }

    else if (!descartar) {

      if (
        (c < 32 && c != '\r') ||
        c > 126 ||
        usados >= sizeof(bufferRx) - 1
      ) {

        descartar = true;

        usados = 0;

      }

      else {

        bufferRx[usados++] = c;
      }
    }
  }
}


// ======================================================
// RESPUESTA /datos
// ======================================================

void datos() {

  char t[24] = "null";
  char h[24] = "null";
  char m[16] = "null";
  char o[24] = "null";
  char edad[24] = "null";


  uint32_t transcurrido =
    (uint32_t)(
      millis() - ultimaTrama
    );


  if (recibido) {

    snprintf(
      m,
      sizeof(m),
      "%d",
      mq
    );


    snprintf(
      edad,
      sizeof(edad),
      "%lu",
      (unsigned long)transcurrido
    );


    if (dsm >= 0) {

      snprintf(
        o,
        sizeof(o),
        "%.3f",
        dsm
      );
    }


    if (dhtOk) {

      snprintf(
        t,
        sizeof(t),
        "%.1f",
        temperatura
      );


      snprintf(
        h,
        sizeof(h),
        "%.1f",
        humedad
      );
    }
  }


  char json[400];


  snprintf(
    json,
    sizeof(json),

    "{\"recibido\":%s,"
    "\"conectado\":%s,"
    "\"edad_ms\":%s,"
    "\"temperatura\":%s,"
    "\"humedad\":%s,"
    "\"mqADC\":%s,"
    "\"ocupacionDSM\":%s,"
    "\"estadoDHT\":%d,"
    "\"rechazadas\":%lu}",

    recibido
      ? "true"
      : "false",

    recibido &&
    transcurrido < 10000
      ? "true"
      : "false",

    edad,

    t,

    h,

    m,

    o,

    dhtOk
      ? 1
      : 0,

    (unsigned long)rechazadas
  );


  servidor.sendHeader(
    "Cache-Control",
    "no-store"
  );


  servidor.send(
    200,
    "application/json; charset=utf-8",
    json
  );
}


// ======================================================
// SETUP ESP32
// ======================================================

void setup() {

  // Monitor Serie USB
  Serial.begin(115200);


  // ------------------------------
  // Comunicación Arduino -> ESP32
  // ------------------------------

  Serial1.setRxBufferSize(256);

  Serial1.begin(
    9600,
    SERIAL_8N1,
    17,   // RX
    18    // TX
  );


  // ------------------------------
  // Crear red Wi-Fi local
  // ------------------------------

  WiFi.mode(WIFI_AP);


  IPAddress ip(
    192,
    168,
    4,
    1
  );


  IPAddress mascara(
    255,
    255,
    255,
    0
  );


  bool configurada =
    WiFi.softAPConfig(
      ip,
      ip,
      mascara
    );


  bool creada =
    WiFi.softAP(
      "EstacionAmbiental",
      "TallerDiseno2026"
    );


  Serial.printf(
    "AP configurada=%d creada=%d\n",
    configurada,
    creada
  );


  Serial.print(
    "Abrir http://"
  );


  Serial.println(
    WiFi.softAPIP()
  );


  // ------------------------------
  // Ruta principal
  // ------------------------------

  servidor.on(
    "/",
    HTTP_GET,
    [](){

      servidor.send_P(
        200,
        "text/html; charset=utf-8",
        PAGINA
      );
    }
  );


  // ------------------------------
  // Ruta de datos JSON
  // ------------------------------

  servidor.on(
    "/datos",
    HTTP_GET,
    datos
  );


  // ------------------------------
  // Ruta inexistente
  // ------------------------------

  servidor.onNotFound(
    [](){

      servidor.send(
        404,
        "text/plain",
        "Ruta no encontrada"
      );
    }
  );


  servidor.begin();
}


// ======================================================
// LOOP ESP32
// ======================================================

void loop() {

  // Recibir datos provenientes del Arduino
  leerUART();

  // Atender solicitudes de celulares,
  // computadores o tablets conectados por Wi-Fi
  servidor.handleClient();
}
